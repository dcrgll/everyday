{
	"name": "everyday",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"commit": "cz",
		"commitlint": "commitlint --edit",
		"dev": "portless --lan",
		"dev:app": "next dev --turbopack",
		"format": "ultracite fix",
		"lint": "ultracite fix",
		"lint:check": "ultracite check",
		"outdated": "pnpm dlx npm-check-updates --root --format group -i",
		"proxy": "portless proxy start --lan",
		"prepare": "lefthook install",
		"start": "next start",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@radix-ui/react-tooltip": "^1.2.8",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"motion": "^12.23.26",
		"next": "16.0.10",
		"next-themes": "^0.4.6",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^25",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"commitizen": "4.3.2",
		"cz-conventional-changelog": "3.3.0",
		"lefthook": "2.1.10",
		"oxfmt": "0.59.0",
		"oxlint": "1.74.0",
		"portless": "0.15.4",
		"postcss": "^8",
		"tailwindcss": "^4.1.18",
		"typescript": "^5",
		"ultracite": "7.9.4"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"packageManager": "pnpm@11.15.1",
	"portless": {
		"name": "everyday",
		"script": "dev:app"
	}
}
