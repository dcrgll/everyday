{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:best-practices", "group:allNonMajor"],
	"prConcurrentLimit": 3,
	"packageRules": [
		{
			"description": "TypeScript 7 drops the JavaScript Compiler API that Next.js still requires for typechecking.",
			"matchPackageNames": ["typescript"],
			"allowedVersions": "<7"
		},
		{
			"groupName": "Next.js and React",
			"groupSlug": "nextjs-react",
			"matchPackageNames": [
				"next",
				"react",
				"react-dom",
				"@types/react",
				"@types/react-dom"
			]
		},
		{
			"groupName": "Tailwind CSS",
			"groupSlug": "tailwindcss",
			"matchPackageNames": ["tailwindcss", "@tailwindcss/postcss"]
		},
		{
			"groupName": "code quality tooling",
			"groupSlug": "code-quality",
			"matchPackageNames": [
				"ultracite",
				"oxfmt",
				"oxlint",
				"typescript",
				"@types/node"
			]
		},
		{
			"groupName": "GitHub Actions",
			"groupSlug": "github-actions",
			"matchManagers": ["github-actions"]
		}
	]
}
